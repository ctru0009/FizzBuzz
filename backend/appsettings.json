{
  // Set real values via environment, see root .env.example. Keys use __ nesting, e.g. ConnectionStrings__DefaultConnection.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Required, empty by default, set ConnectionStrings__DefaultConnection in the environment.
    "DefaultConnection": "",
    // Required, empty by default, set ConnectionStrings__Redis in the environment.
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "fizzbuzz",
    "Audience": "fizzbuzz",
    // No signing key default here on purpose. Set the JWT__SigningKey env var to a 32+ char secret.
    "LifetimeHours": 8
  },
  "Game": {
    "NumberIntervalSeconds": 15
  },
  "Cors": {
    // Required, set Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, etc. in the environment.
    "AllowedOrigins": []
  }
}

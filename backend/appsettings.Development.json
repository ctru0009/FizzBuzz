{
  // Dev overrides. Connection strings and the JWT key still come from the environment, see root .env.example.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Local fallback when no env var is set. Password stays change-me, never a real secret.
    "DefaultConnection": "Host=localhost;Port=5433;Database=fizzbuzz;Username=postgres;Password=change-me",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}

# Local dev defaults for Docker Compose. Copy to .env and adjust. Placeholder values only, never real secrets.
POSTGRES_DB=fizzbuzz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=fizzbuzz;Username=postgres;Password=change-me
ConnectionStrings__Redis=redis_db:6379,abortConnect=false
NEXT_PUBLIC_BASE_URL=http://localhost:8080
ASPNETCORE_ENVIRONMENT=Development
# JWT, 8h tokens. The signing key must be 32+ chars, boot fails without it.
Jwt__Issuer=fizzbuzz
Jwt__Audience=fizzbuzz
Jwt__SigningKey=change-me-to-a-32-plus-char-secret-value
Jwt__LifetimeHours=8
# Session ticker cadence in seconds, valid 5..120.
Game__NumberIntervalSeconds=15
# CORS origins, one entry per index.
Cors__AllowedOrigins__0=http://localhost:3000
